MaterialDef FilmGrain {
    MaterialParameters {
        Int NumSamples
        Texture2D Texture
        Float Time
    }
    Technique {
        VertexShader GLSL330: Common/MatDefs/Post/film_grain.vert
        FragmentShader GLSL330: Common/MatDefs/Post/film_grain.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }
    }
}