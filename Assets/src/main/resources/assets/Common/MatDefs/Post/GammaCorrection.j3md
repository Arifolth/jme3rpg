MaterialDef GammaCorrection {
 
    MaterialParameters {
        Int NumSamples
        Texture2D Texture
        Float InvGamma       
    }
 
    Technique {
        VertexShader    GLSL450 GLSL400 GLSL300 GLSL150 GLSL120: Common/MatDefs/Post/Post15.vert
        FragmentShader  GLSL450 GLSL400 GLSL300 GLSL150 GLSL120: Common/MatDefs/Post/GammaCorrection15.frag
 
        WorldParameters {
        }
        
        Defines { 
            RESOLVE_MS : NumSamples
        }
    }
}