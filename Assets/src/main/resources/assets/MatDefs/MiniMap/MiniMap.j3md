MaterialDef Unshaded {

    MaterialParameters {

        Texture2D ColorMap
        Texture2D Mask
        Texture2D Overlay

    }

    Technique {
        VertexShader GLSL400 GLSL300 GLSL150 GLSL120:   MatDefs/MiniMap/MiniMap.vert
        FragmentShader GLSL400 GLSL300 GLSL150 GLSL120: MatDefs/MiniMap/MiniMap.frag

        WorldParameters {
            WorldViewProjectionMatrix
            ViewProjectionMatrix
            ViewMatrix
        }


    }



}